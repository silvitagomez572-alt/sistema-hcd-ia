# Copiar a .env local (ignorado). Rutas relativas se resuelven desde el directorio de inicio.
HCD_API_URL=http://127.0.0.1:8000
HCD_PUBLIC_API_URL=http://127.0.0.1:8000
HCD_DB_PATH=./hcs.db
HCD_MODEL_PATH=./modelo_area_intervenciones.pkl
HCD_PROFESSIONALS_PATH=./.local/profesionales.json
HCD_UPLOAD_DIR=./uploads/censos
HCD_CENSO_INPUT_DIR=./.local/censos
HCD_RAG_DB_PATH=./rag/db-reviewed
HCD_PROTOCOLS_DIR=./rag/protocolos
# Directorio de SentenceTransformer ya disponible localmente; nunca se descarga al iniciar.
HCD_EMBEDDING_MODEL_PATH=
HCD_MAX_UPLOAD_BYTES=10485760
HCD_API_USER=operador
# Obligatorio para Docker/LAN. Generar localmente; no publicar.
HCD_API_PASSWORD=
HCD_ALLOW_DELETE=0
# Conservar el valor institucional durante el traslado para no cambiar pseudónimos.
# PSEUDONYM_SALT=
OLLAMA_URL=http://localhost:11434
# Pendiente de conocer hardware y modelos instalados. No se descarga automáticamente.
OLLAMA_MODEL=
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
ANONYMIZED_TELEMETRY=False
